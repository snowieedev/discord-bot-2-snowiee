# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# PostgreSQL Database URL
DATABASE_URL=postgresql://user:password@localhost:5432/community_bot

# Development Guild ID (Optional: for faster slash command registration during dev)
DEV_GUILD_ID=your_guild_id_here

# Module Channels
SUGGESTIONS_CHANNEL_ID=your_suggestions_channel_id_here
BUGS_CHANNEL_ID=your_bugs_channel_id_here

# Staff Roles (Comma separated role IDs)
STAFF_ROLE_IDS=role_id_1,role_id_2
